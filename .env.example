SUPABASE_SERVICE_ROLE_KEY=""

# Anthropic
ANTHROPIC_API_KEY=""

# Optional — overrides MODELS.HIGH_STAKES_SYNTHESIS (lib/ai/models.ts) for
# trigger/diagnosis.ts and trigger/strategy-generation.ts specifically. Set
# to "claude-sonnet-5" to force a run back to Sonnet for a side-by-side
# comparison against Opus output on the same app/inputs. Leave unset in
# normal operation.
SYNTHESIS_MODEL_OVERRIDE=""

# OpenRouter (for Llama bulk content)
OPENROUTER_API_KEY=""

# Firecrawl
FIRECRAWL_API_KEY=""

# SerpAPI — used by competitor-gap-analysis (Source 2: app store keyword
# search via site:play.google.com / site:apps.apple.com). Firecrawl's own
# search doesn't reliably surface app store listing pages.
SERPAPI_KEY=""

# PostEverywhere
POSTEVERYWHERE_API_KEY=""

# Product Hunt — used by lib/chat/forum-search.ts's search_forums_live chat
# tool (product_hunt platform only). Get a dev app token at
# https://api.producthunt.com/v2/oauth/applications. Reddit/Hacker News/
# Stack Overflow/Indie Hackers in that same tool need no key (public APIs,
# or reuse FIRECRAWL_API_KEY above).
PRODUCT_HUNT_API_TOKEN=""

# Google Gemini (image generation)
GEMINI_API_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
